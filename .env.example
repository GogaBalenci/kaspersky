HTTP_ADDRESS=:8080
DATABASE_URL=postgres://threats:threats@localhost:5432/threats?sslmode=disable
# Generate a real local secret, for example: openssl rand -hex 32
API_KEY=
RATE_LIMIT_PER_MINUTE=60
RATE_LIMIT_BURST=10
REQUIRE_API_KEY_FOR_READS=false
REQUEST_TIMEOUT=5s
# Set both to serve HTTPS directly (optional).
TLS_CERT_FILE=
TLS_KEY_FILE=
# Used by docker compose; generate with: openssl rand -hex 32
POSTGRES_PASSWORD=
DB_MAX_CONNS=10
DB_MIN_CONNS=1
DB_MAX_CONN_LIFETIME=1h
DB_MAX_CONN_IDLE_TIME=30m
DB_HEALTH_CHECK_PERIOD=1m
